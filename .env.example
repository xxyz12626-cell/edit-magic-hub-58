# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Safe for client exposure (used during build and client-side Supabase client initialization)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id

# ==============================================================================
# SSR & Server-Side Environment Variables (Vercel Production)
# ==============================================================================
# Required for SSR rendering, server functions, and database queries
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_PROJECT_ID=your-supabase-project-id

# SECRET: Service role key for admin operations and backend tasks.
# NEVER expose this key to client-side code. Add this to Vercel Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Optional: Shared secret for /api/public/ingest-events endpoint fallback
INGEST_SECRET=your-optional-ingest-secret
